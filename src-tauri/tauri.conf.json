{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Easy Paper",
  "version": "1.3.1",
  "identifier": "easy-paper",
  "build": {
    "beforeDevCommand": "npm run build:tap && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:tap && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "easy-paper",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "target/release/taskbar_tap.dll": "taskbar_tap.dll"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwNjMwQzJBNTUwRDlBRTUKUldUbG1nMVZLZ3hqc0RQcHhQRjlwaU9CRzlwajV1RzI3U0hMZUJDbUc4Y1J6MHA2NXBoSEdUVUUK",
      "endpoints": [
        "https://github.com/LucasOSantana/easy-paper/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
